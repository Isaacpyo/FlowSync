{
  "name": "@flowsync/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlowSync API: Express + Socket.io + Prisma.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node --enable-source-maps dist/index.js",
    "start:render": "prisma migrate deploy && node --enable-source-maps dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx src/demo/seed-cli.ts",
    "bench:latency": "tsx scripts/bench-latency.ts"
  },
  "dependencies": {
    "@flowsync/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.4",
    "dotenv-cli": "11.0.0",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "4.1.11"
  }
}
