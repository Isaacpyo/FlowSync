// FlowSync data model.
//
// Ordering: Column.position and Task.position are fractional index keys
// (see packages/shared/src/fractional-index.ts). The migration declares them
// COLLATE "C" so Postgres compares them byte-wise, exactly like JavaScript.
// Prisma has no schema syntax for column collation, so that lives in the SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (Neon: the "-pooler" host).
  url       = env("DATABASE_URL")
  // Direct connection for migrations. Locally it is the same URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  name          String
  /// Null for guest (demo) accounts, which can only sign in via "Try the demo".
  passwordHash  String?
  avatarColor   String
  isGuest       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  assignedTasks Task[]       @relation("TaskAssignee")
  createdTasks  Task[]       @relation("TaskCreator")
  messages      Message[]
  activities    Activity[]

  @@index([isGuest, createdAt])
}

model Workspace {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  /// The shared, periodically re-seeded workspace that guests join.
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  members   Membership[]
  boards    Board[]
}

model Membership {
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model Board {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  name        String
  description String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  tasks       Task[]
  messages    Message[]
  activities  Activity[]

  @@index([workspaceId])
}

model Column {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  position  String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([boardId, position])
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @db.Uuid
  columnId    String    @db.Uuid
  title       String
  description String    @default("")
  position    String
  priority    Priority  @default(MEDIUM)
  assigneeId  String?   @db.Uuid
  creatorId   String?   @db.Uuid
  dueDate     DateTime? @db.Date
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User?     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  // Two tasks can never share a slot in a column. Writers serialise on the
  // column row, so this only fires if that invariant is ever broken.
  @@unique([columnId, position])
  @@index([boardId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String
  data      Json
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}
