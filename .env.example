# FlowSync environment variables.
# Copy to `.env` for local development (`cp .env.example .env`).
# docker compose sets its own values and does not need this file.
# Never commit real secrets.

# ----------------------------------------------------------------- API (apps/api)

# Runtime mode: development | test | production.
NODE_ENV=development
# HTTP + WebSocket port. Render injects PORT automatically.
PORT=4000

# Postgres connection used by the app. On Neon, use the *pooled* connection
# string (host contains "-pooler") and keep `sslmode=require`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowsync
# Direct (non-pooled) connection used only by `prisma migrate`. On Neon, the
# same string without "-pooler". Locally it is identical to DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/flowsync

# Redis for the Socket.io adapter, which fans events out across API instances.
# Upstash: use the `rediss://default:<password>@<host>:6379` URL (TLS).
# Leave empty to use the in-memory adapter (fine for a single instance).
REDIS_URL=redis://localhost:6379

# Secret for signing JWTs. Required in production, 32+ characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of origins allowed to call the API (CORS + Socket.io).
# `*` wildcards are allowed, e.g. https://deploy-preview-*--your-site.netlify.app
CORS_ORIGIN=http://localhost:5173

# Enable the "Try the demo" guest login and the seeded demo workspace.
DEMO_ENABLED=true
# Re-seed the demo workspace on boot when it is older than this many hours (0 = never).
DEMO_RESET_HOURS=6

# Max login/signup/demo requests per IP per 15 minutes.
AUTH_RATE_LIMIT=30

# pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# ----------------------------------------------------------------- Web (apps/web)

# Public URL of the API, baked into the frontend at build time.
# Netlify: https://<your-render-service>.onrender.com
VITE_API_URL=http://localhost:4000

# ----------------------------------------------------------------- Tests

# Database for the API integration tests (wiped by the test run).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowsync_test
# Optional: set to run the cross-instance Redis adapter test.
TEST_REDIS_URL=redis://localhost:6379

# Database for the Playwright end-to-end run (`pnpm e2e`).
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowsync_e2e
# Optional: Redis for the end-to-end run (empty = in-memory adapter).
E2E_REDIS_URL=
